# vLLM container image. v0.26.0-cu129 is the release that has BOTH the SM120
# sparse-MLA attention backend (FLASHINFER_MLA_SPARSE_SM120) and a matched
# FlashInfer 0.6.14 whose trtllm MLA decode kernel accepts kv_scale_format.
# v0.25.1-cu129 has the backend but FlashInfer 0.6.13 rejects that arg (crash);
# glm52-cu129 bundles matched FlashInfer but that dev build dropped the SM120
# backend. cu129 runs on the host driver 570.195.03 (CUDA 12 minor-version
# compatibility); cu13 images (incl. the b12x SM120 image) need driver >=580.
VLLM_IMAGE=vllm/vllm-openai:v0.26.0-cu129

# Host Hugging Face cache root (read-only mount source).
HOST_HF_CACHE=/raid/huggingface_pavel

# Model path inside the container (under the /hf mount).
MODEL_DIR=/hf/models--cyankiwi--GLM-5.2-AWQ-INT4/snapshots/0baf1f00d05d19e6e01e5451ed6cc54a0a93c5f2

SERVED_MODEL_NAME=glm-5.2-awq-int4

# UVA offload budget, in GiB, per GPU. Pinned host RAM = N x 4 ranks (LOCKED).
# vLLM-measured weights ~106 GiB/rank; GPU budget (0.95 util) ~90 GiB.
# Single-session 128K: 128K needs ~6.6 GiB KV/rank (MLA latent replicated across
# TP ranks) -> free that VRAM by offloading 27 -> ~79 GiB weights on-GPU, pool
# ~150K tokens. Pinned = 4 x 27 = 108 GiB (proven-safe offload=24 pinned 96; the
# 256K attempt at offload=33 pinned 132 and locked the box). Lower (24) -> faster
# decode but only ~88K-token pool. No DCP (rejects fp8 KV).
CPU_OFFLOAD_GB=27

# Fraction of GPU memory that vLLM is allowed to use.
GPU_MEM_UTIL=0.95

# Maximum context length (prompt + output) in tokens. Single-session target.
# 256K locked the box (offload=33 pinned 132 GiB + 4-rank load transient ->
# thrash/OOM). 128K needs ~6.6 GiB KV/rank (MLA latent replicated across TP
# ranks) -> free that VRAM via CPU_OFFLOAD_GB=27 (pool ~150K tokens). Pinned
# = 108 GiB (+12 over proven-safe offload=24). Decode TPS is flat with context
# (DSA), so the ceiling is KV memory, not speed. No DCP (rejects fp8 KV).
MAX_MODEL_LEN=131072

# Decode-context-parallel size. 1 = off (no KV sharding). 4 would be needed for
# 256K but is unsupported by the SM120 sparse-MLA backend on stock vLLM (see the
# MAX_MODEL_LEN note). Leave at 1.
DCP_SIZE=1

# Maximum concurrent sequences. Set to 1 for single-stream, latency-optimized
# serving (no batching/continuous batching). Decode TPS is measured per request.
MAX_NUM_SEQS=1

# Expert parallelism (TESTED 2026-07-25, NULL RESULT). EP shards the 256 MoE
# experts across the 4 GPUs (Worker_TPi_EPi). Decode stayed 8.6 tok/s vs 8.6
# baseline: most experts are resident (only 24 GiB offloaded), so the per-token
# all-to-all MoE comm cancels the residency gain. EP is NOT the decode lever on
# this offloaded stack. Empty = tensor-parallel-only MoE (default).
EP_FLAG=

# CUDA-graph mode. EAGER_FLAG= (empty) enables CUDA graphs -- RECOMMENDED:
# measured 26.6 tok/s decode vs 8.6 eager (3.1x), the dominant decode lever.
# The bottleneck was framework/launch overhead across 100+ layers at bs=1,
# NOT PCIe expert fetch. Graphs capture cleanly for bs in {1,2} (0.04 GiB,
# no OOM) and do not change outputs. EAGER_FLAG=--enforce-eager disables
# capture (debugging only; costs ~3x decode). max-num-seqs=1 = ideal for capture.
EAGER_FLAG=

# CUDA-graph profiler reserve. 0 reclaims the reserve (eager only). -1 = auto,
# required when graphs are ON so the profiler reserves real capture memory.
ESTIMATE_CUDAGRAPHS=-1

HOST_PORT=8000
